# LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Footage Provider
PIXABAY_API_KEY=your_pixabay_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# YouTube OAuth (Official API)
YT_CLIENT_ID=your_client_id.apps.googleusercontent.com
YT_CLIENT_SECRET=your_client_secret
YT_REFRESH_TOKEN=your_oauth_refresh_token

# Vision Provider (Optional - Gemini API for describing video_idea keyframes)
GEMINI_API_KEY=your_gemini_api_key_here

# TikTok Direct Headless Upload (Optional - sessionid cookie from tiktok.com)
TIKTOK_SESSION_ID=your_tiktok_sessionid_cookie_value

